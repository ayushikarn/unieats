# ============================================================
# UniEats — .gitignore
# ============================================================

# --- Environment secrets ---
.env
*.env.local
*.env.development
*.env.production
!.env.example

# --- Node / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- TypeScript / Build outputs ---
*.tsbuildinfo
dist/
build/
*.log

# --- Prisma / Database ---
*.db
*.sqlite
*.sqlite3

# --- Docker ---
docker-compose.override.yml
Dockerfile.override

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Additional secret protection ---
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# --- Claude local configuration ---
.claude/settings.local.json

# --- Local project notes ---
memory/
# Claude local files
.claude/